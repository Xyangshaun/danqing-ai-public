# ============================================================
# 丹青有AI 后端 - 环境变量示例(.env.example)
# 复制为 .env 并填入真实值;生产环境通过 Secret Manager 注入
# 严禁提交真实 .env 文件到 git
# ============================================================

# ---------- 飞书 OAuth ----------
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxx
# 重定向 URI(按 client 区分;Phase 1 Web 端为主)
FEISHU_REDIRECT_URI_WEB=http://localhost:5173/auth/feishu/callback
FEISHU_REDIRECT_URI_ADMIN=http://localhost:3001/auth/feishu/callback
FEISHU_REDIRECT_URI_MOBILE=http://localhost:8081/auth/feishu/callback
# 飞书 API 端点(默认值,如需覆盖可修改)
FEISHU_AUTHZ_ENDPOINT=https://open.feishu.cn/open-apis/authen/v1/authorize
FEISHU_TOKEN_ENDPOINT=https://open.feishu.cn/open-apis/authen/v1/oidc/access_token
FEISHU_USERINFO_ENDPOINT=https://open.feishu.cn/open-apis/authen/v1/user_info

# ---------- JWT 密钥(RS256) ----------
# PEM 格式,生产从 KMS 读取;开发环境可用以下命令生成:
# openssl genrsa -out private.pem 2048
# openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEpAIBAAKCAQEA...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEF...\n-----END PUBLIC KEY-----"
JWT_KEY_ID=danqing-ai-2026-07
JWT_ISSUER=danqing-ai-auth
JWT_AUDIENCE_WEB=danqing-ai-web
JWT_AUDIENCE_ADMIN=danqing-ai-admin
JWT_AUDIENCE_MOBILE=danqing-ai-mobile
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ---------- Cookie / CSRF ----------
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_SAMESITE=strict
COOKIE_PATH=/auth
COOKIE_MAX_AGE=604800

# ---------- 基础设施 ----------
DATABASE_URL=postgresql://danqing:danqing@localhost:5432/danqing
REDIS_URL=redis://localhost:6379

# ---------- CORS 白名单(逗号分隔,禁止 *) ----------
CORS_ORIGINS=http://localhost:5173,http://localhost:3001,http://localhost:8081

# ---------- 限流(次/分钟) ----------
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_CALLBACK_PER_MIN=5
RATE_LIMIT_REFRESH_PER_MIN=20
RATE_LIMIT_API_PER_MIN=60

# ---------- 租户默认值 ----------
TENANT_DEFAULT_PLAN=free
TENANT_DEFAULT_TYPE=individual

# ---------- 安全开关 ----------
ENABLE_HSTS=false
LOG_LEVEL=info
NODE_ENV=development
PORT=3000

# ---------- 文件上传 ----------
# multer 磁盘存储目录(相对于 server/),分析完成后自动清理
UPLOAD_DIR=uploads
# 单文件大小上限(字节,默认 10MB,对应技术约束 ≤10MB)
UPLOAD_MAX_SIZE=10485760

# ---------- AI 视觉分析(Phase 2 追加) ----------
# 详细设计见:.trae/documents/ai-integration-design.md
# 模型选型:智谱 GLM-4V(OpenAI 兼容格式,中国网络直连,glm-4v-flash 免费)
#
# 总开关:默认关闭,生产环境手动开启
# - false:仅使用 Jimp 像素分析(现有逻辑,~500ms)
# - true :启用混合分析(Jimp + AI,~2-2.5s,3 秒 SLA 保障)
AI_ENABLED=false

# 智谱 API Key(格式 xxxxxxxxxx.xxxxxxxx)
# 获取地址:https://open.bigmodel.cn/usermanage/apikey
# 留空时即使 AI_ENABLED=true 也会自动 fallback 到 Jimp
AI_API_KEY=

# 智谱 GLM-4V API 端点(OpenAI 兼容格式)
# 默认值指向智谱开放平台,无需修改
AI_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions

# AI 请求超时(毫秒,硬性 2500ms 保障 3 秒 SLA)
# 双层超时保障(P3-2.2):
#   1. axios timeout:连接/响应超时
#   2. AbortController wall-clock deadline:2.5s 硬切断,兜底慢速 body 流
# 超时立即切断走 Jimp fallback,不重试
AI_API_TIMEOUT=2500

# 问题分析(阶段3 ask-question)专用超时(毫秒,默认 60000)
# 追问是深度分析后的延伸交互,不受 3 秒 SLA 约束,与 AI_API_TIMEOUT 解耦
AI_QA_TIMEOUT=60000

# AI 深度分析(阶段2 ai-enhance)专用超时(毫秒,默认 15000;2026-08-18 实测深度分析
# 输出量大需生成大量 tokens,线上务必配置 >=150000,与前端 180s 等待对齐)
AI_ENHANCE_TIMEOUT=150000

# 问题分析每用户每分钟上限(默认 10;防 AI 成本滥用,Redis 异常时 fail open)
RATE_LIMIT_ASK_QUESTION_PER_MIN=10

# AI 模型名
# - glm-4v-flash :免费,10 RPM,推荐默认
# - glm-4v-plus  :付费,4 元/百万 tokens,高精度场景可选
AI_API_MODEL=glm-4v-flash

# ---------- TRAE AI 服务配置(可选,留空时自动降级到 GLM) ----------
# 仅当 AI_PROVIDER=trae 时生效;TRAE 凭证不完整时自动降级到 GLM
AI_PROVIDER=glm
TRAE_API_KEY=
TRAE_API_URL=
TRAE_API_MODEL=

# ---------- AI 图像生成(M-2,独立于诊断链路,对应 m2-generation-plan §2.4) ----------
# 详细设计见:.trae/documents/m2-generation-plan-2026-08-07.md §2.4 / §9
# 生成走异步队列,超时独立配置,不受诊断 2.5s 限制
#
# 主提供商标识(trae=主 / glm=备,默认 trae)
# 必填:是 | 取值:trae | glm | 默认:trae
AI_IMAGE_PROVIDER=trae
#
# 图像生成 API Key(主提供商)
# 必填:是(生产) | ⚠️ 安全提示:严禁提交 git,生产从 Secret Manager/KMS 注入
# 开发环境可用占位符 <your-api-key>;缺失时生成功能优雅降级(GENERATION_PROVIDER_UNAVAILABLE),不崩溃
AI_IMAGE_API_KEY=<your-api-key>
#
# 图像生成端点 URL(OpenAI 兼容格式)
# 必填:是(生产)
AI_IMAGE_API_URL=
#
# 图像生成模型名(如 glm 生态 GLM-Image / trae 对应图像模型)
# 必填:是(生产)
AI_IMAGE_API_MODEL=
#
# 生成请求超时(毫秒,默认 90000,独立于诊断 2500;生成走异步队列不受 3 秒 SLA 限制)
# GLM-Image 在服务器链路实测约 60s,需预留 buffer
# 必填:否 | 默认:90000
AI_IMAGE_TIMEOUT=90000
#
# 单用户生成限流(次/分钟,默认 5)
# 必填:否 | 默认:5
GENERATION_RATE_LIMIT_PER_MIN=5
#
# 单任务最大生成张数(默认 4,对应冻结契约 count 上限)
# 必填:否 | 默认:4
GENERATION_MAX_COUNT=4

# ---------- 部署日志同步(任务包 C) ----------
# 部署脚本(deploy-ssh.sh)通过 X-Deploy-Secret 请求头上报部署结果
# 必须与部署脚本中配置的密钥一致;留空则禁用 /api/v1/deployments/* 端点(返回 503)
DEPLOY_SYNC_SECRET=
