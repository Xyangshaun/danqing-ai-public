# ============================================================
# 丹青有AI - Docker 部署环境变量示例
#
# 复制为 server/.env 并填入真实值后再 docker compose up
# 对应文档:.trae/documents/redis-brpop-fix-2026-08-07.md
# ============================================================

# ---------- 运行环境 ----------
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# ---------- Redis 监控(固化配置)----------
# rate-limit Redis 操作硬超时(毫秒),超时后 fail open 放行请求
# 默认 200ms,生产环境建议保持 200ms,过高会导致请求堆积
RATE_LIMIT_REDIS_TIMEOUT_MS=200

# Redis 指标日志输出间隔(毫秒),定时输出连接状态与命令耗时摘要
# 默认 30000ms(30s),生产监控可缩短到 15000ms
REDIS_METRICS_LOG_INTERVAL_MS=30000

# ---------- Redis ----------
# Docker compose 内使用服务名 redis;独立部署用 127.0.0.1:6379
REDIS_URL=redis://redis:6379

# ---------- 数据库 ----------
DATABASE_URL=postgresql://user:password@postgres:5432/danqing_ai?schema=public

# ---------- 飞书 OAuth ----------
FEISHU_APP_ID=cli_xxxx
FEISHU_APP_SECRET=xxxx
FEISHU_REDIRECT_URI_WEB=https://www.danqing.site/app/auth/feishu/callback

# ---------- JWT(RS256)----------
# 私钥/公钥:单行,\n 转义换行,双引号包裹
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_KEY_ID=danqing-2026

# ---------- CORS ----------
CORS_ORIGINS=https://www.danqing.site,https://danqing.site

# ---------- Cookie ----------
COOKIE_SECURE=true
COOKIE_DOMAIN=.danqing.site

# ---------- 限流(每分钟)----------
# 注:CI 并发压测(docker compose --profile perf run perf-test)会触发 429;
#     压测脚本接受 200/429 为预期响应。如需测真实并发吞吐(非限流),
#     CI 临时调高 AUTH/CALLBACK 限流至 10000 后重跑。
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_CALLBACK_PER_MIN=5
RATE_LIMIT_REFRESH_PER_MIN=20
RATE_LIMIT_API_PER_MIN=60

# ---------- 部署日志同步 ----------
DEPLOY_SYNC_SECRET=your-deploy-secret-here
