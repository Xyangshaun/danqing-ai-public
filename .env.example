# 丹青有AI - 前端环境变量示例
# 复制本文件为 .env.local 并按需修改

# 后端 API Base URL(对应 api-contract-v1.md §1.1)
# 本地开发默认指向后端服务(Phase 1 Task 4 已运行在 http://localhost:3000)
VITE_API_BASE_URL=http://localhost:3000/api/v1

# 飞书 OAuth 重定向 URI(开发环境)
# 飞书回调会访问 http://localhost:5173/auth/feishu/callback?code=xxx&state=xxx
# 前端在 main.tsx 检测该路径并交给 AuthCallbackPage 处理
VITE_FEISHU_REDIRECT_URI=http://localhost:5173/auth/feishu/callback
