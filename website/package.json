{
  "name": "danqing-ai-website",
  "version": "1.0.0",
  "private": true,
  "description": "丹青有AI 品牌官网 - 面向高校艺术教育的 AI 作业诊断系统",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
